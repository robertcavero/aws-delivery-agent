{
  "Comment": "Assistente de IA para Delivery Dinâmico",
  "StartAt": "Pedido de Teste",
  "States": {
    "Pedido de Teste": {
      "Type": "Pass",
      "Next": "Extrair_Pedido",
      "Output": {
        "pedido": "Quero pedir 2 pizzas de mussarela e uma Coca-Cola 2L para a Rua Augusta, 67."
      }
    },
    "Extrair_Pedido": {
      "Type": "Task",
      "Resource": "arn:aws:states:::bedrock:invokeModel",
      "Arguments": {
        "ModelId": "arn:aws:bedrock:us-east-2::foundation-model/amazon.nova-lite-v1:0",
        "ContentType": "application/json",
        "Accept": "application/json",
        "Body": {
          "messages": [
            {
              "role": "user",
              "content": [
                {
                  "text": "{% 'Analise o seguinte pedido do cliente e extraia os itens, o endereço de entrega e observações em formato JSON: ' & $states.input.pedido %}"
                }
              ]
            }
          ],
          "inferenceConfig": {
            "temperature": 0,
            "topP": 1,
            "maxTokens": 512
          }
        }
      },
      "Assign": {
        "dados_pedido": "{% $states.result.Body.output.message.content[0].text %}"
      },
      "Next": "Planejar_Rota"
    },
    "Planejar_Rota": {
      "Type": "Task",
      "Resource": "arn:aws:states:::bedrock:invokeModel",
      "Arguments": {
        "ModelId": "arn:aws:bedrock:us-east-2::foundation-model/amazon.nova-lite-v1:0",
        "ContentType": "application/json",
        "Accept": "application/json",
        "Body": {
          "messages": [
            {
              "role": "user",
              "content": [
                {
                  "text": "{% 'Com base nos dados extraídos, crie uma rota e instruções de entrega: ' & $dados_pedido %}"
                }
              ]
            }
          ],
          "inferenceConfig": {
            "temperature": 0,
            "topP": 1,
            "maxTokens": 512
          }
        }
      },
      "Assign": {
        "instrucoes_rota": "{% $states.result.Body.output.message.content[0].text %}"
      },
      "Next": "Gerar_Mensagem_Cliente"
    },
    "Gerar_Mensagem_Cliente": {
      "Type": "Task",
      "Resource": "arn:aws:states:::bedrock:invokeModel",
      "Arguments": {
        "ModelId": "arn:aws:bedrock:us-east-2::foundation-model/amazon.nova-lite-v1:0",
        "ContentType": "application/json",
        "Accept": "application/json",
        "Body": {
          "messages": [
            {
              "role": "user",
              "content": [
                {
                  "text": "{% 'Escreva uma mensagem educada e enxuta para o cliente com base na rota planejada. Instruções da rota: ' & $instrucoes_rota %}"
                }
              ]
            }
          ],
          "inferenceConfig": {
            "temperature": 0.3,
            "topP": 1,
            "maxTokens": 512
          }
        }
      },
      "End": true
    }
  },
  "QueryLanguage": "JSONata"
}